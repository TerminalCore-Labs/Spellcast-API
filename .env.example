
# Spellcast-API environment variables.
# Copy to .env and fill in. Names must match exactly; see app/config/__init__.py.
# The real .env is gitignored — never commit secrets.

# Environment: "development" (local) or "production" (Fly). Drives CORS and the
# APP_ENV/bucket guard (a dev run must use a *-dev bucket).
APP_ENV=development

# --- Required (the app will not boot without these) ---
DATABASE_URL=            # Postgres/Supabase connection string
FERNET_KEY=              # Fernet key encrypting users' stored TTS credentials

# --- Auth / crypto ---
PRIVATE_SECRET=
ALGORITHM=

# --- Azure Speech ---
AZURE_URL=
AZURE_API_KEY=
AZURE_DEFAULT_VOICE=

# --- Default voices (AWS Polly / GCP) ---
AWS_DEFAULT_VOICE=
GCP_DEFAULT_VOICE=

# --- AWS (S3 + Polly). In dev use the scoped dev key + the -dev bucket. ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET=              # e.g. spellcast-storage (prod) / spellcast-storage-dev (dev)
AWS_BUCKET_REGION=

# --- Misc ---
ID=
REDIS_PASSWORD=
SPELLCAST_VOICES_CACHE_TTL_SECONDS=
ALLOWED_ORIGINS_DEV=[]   # JSON array of allowed origins, dev only

